{
  "ver": 1,
  "policy_id": "algoos_distributed_v1",
  "unknown_field_policy": "preserve",
  "message_types": [
    "compile_task",
    "eval_task",
    "eval_result",
    "special_task",
    "special_result",
    "cancel",
    "fallback"
  ],
  "modes": {
    "judge_mode": [
      "normal",
      "special"
    ],
    "compare_mode": [
      "common",
      "special"
    ],
    "evaluation_mode": [
      "all_cases",
      "ordered_short_circuit"
    ]
  },
  "worker_cpp_standard": "c++23",
  "compiler_profiles": {
    "cpp_baseline_v1": {
      "language": "cpp17",
      "compiler": "g++",
      "flags": [
        "-std=c++17",
        "-O2",
        "-pipe"
      ],
      "limits": {
        "cpu_ms": 10000,
        "wall_ms": 30000,
        "mem_bytes": 536870912,
        "out_bytes": 1048576
      }
    }
  },
  "transport": {
    "encoding": "UTF-8",
    "broker": "nats_jetstream",
    "broker_payload": "json_without_length_prefix",
    "legacy_tcp_framing": "uint32_be_length_then_json",
    "compile_task_subject": "algoos.compile.task",
    "compile_result_subject": "algoos.compile.result",
    "eval_task_subject_template": "algoos.eval.task.{target_node_id}",
    "eval_result_subject": "algoos.eval.result",
    "special_task_subject": "algoos.special.task",
    "special_result_subject_template": "algoos.special.result.{target_eval_node}",
    "cancel_subject": "algoos.cancel",
    "fallback_subject": "algoos.fallback",
    "heartbeat_subject": "algoos.heartbeat",
    "outbox_subject": "algoos.control.outbox",
    "stream_name": "ALGOOS",
    "node_id_pattern": "^[A-Za-z0-9_-]{1,64}$"
  },
  "objects": {
    "bucket": "algoos",
    "source_prefix": "source",
    "binary_prefix": "bin",
    "test_bundle_prefix": "tests",
    "output_prefix": "out",
    "checker_prefix": "checker",
    "compile_log_prefix": "logs/compile",
    "content_hash_algorithm": "sha256",
    "wire_prefix": "sha256:",
    "build_key_fields": [
      "source_hash",
      "compiler_profile",
      "compiler_version",
      "target_platform"
    ]
  },
  "runtime": {
    "wall_limit_rule": "cpu_ms_plus_wall_slack",
    "default_wall_slack_ms": 1000,
    "memory_limit_source": "cgroup_v2_memory_max",
    "output_limit_mode": "verdict",
    "fsize_slack_bytes": 4096,
    "fsize_max_bytes": 268435456,
    "sandbox": {
      "cgroup_root": "/sys/fs/cgroup",
      "use_cgroup": true,
      "use_user_namespace": false,
      "namespaces": [
        "mount",
        "pid",
        "net",
        "uts",
        "ipc"
      ],
      "seccomp": true,
      "tmpfs_size_bytes": 268435456
    },
    "output_limit_verdict": "WR",
    "output_limit_reason": "OUTPUT_LIMIT"
  },
  "special": {
    "checker_limits": {
      "cpu_ms": 5000,
      "wall_ms": 5000,
      "mem_bytes": 536870912,
      "out_bytes": 1048576
    },
    "contract": {
      "exit_code_0": "AC",
      "exit_code_1": "WA",
      "other_exit_or_signal": "SE"
    }
  },
  "result": {
    "compile_identity_fields_null": [
      "test_id",
      "sequence",
      "judge_id"
    ],
    "compile_success_required_fields": [
      "bin_hash",
      "test_bundle_hash",
      "compiler_profile",
      "enqueue_seq"
    ],
    "memory_sources": [
      "rss_peak",
      "cgroup_peak"
    ],
    "statuses": [
      "COMPILED",
      "FINAL"
    ],
    "default_status": "FINAL",
    "sources_by_stage": {
      "compile": [
        "compiler"
      ],
      "eval": [
        "runner",
        "special",
        "fallback"
      ]
    },
    "final_verdicts_by_stage": {
      "compile": [
        "CE",
        "SE"
      ],
      "eval": [
        "AC",
        "CANCELLED",
        "MLE",
        "RE",
        "SE",
        "TLE",
        "WA",
        "WR"
      ]
    },
    "reason_by_verdict": {
      "AC": [
        "NONE"
      ],
      "CANCELLED": [
        "SHORT_CIRCUITED",
        "USER_CANCELLED"
      ],
      "CE": [
        "COMPILE_ERROR",
        "COMPILE_TIMEOUT",
        "COMPILE_LIMIT"
      ],
      "MLE": [
        "OOM_KILL",
        "MEM_PEAK_OVER"
      ],
      "RE": [
        "CRASH_SIGNAL",
        "NONZERO_EXIT"
      ],
      "SE": [
        "SYSTEM_ERROR"
      ],
      "TLE": [
        "WALL_TIMEOUT",
        "CPU_TIMEOUT"
      ],
      "WA": [
        "ANSWER_MISMATCH",
        "OUTPUT_LIMIT",
        "SPECIAL_WA"
      ],
      "WR": [
        "OUTPUT_LIMIT"
      ]
    },
    "classification_priority": [
      "SYSTEM_ERROR",
      "OOM_KILL",
      "WALL_TIMEOUT",
      "CPU_LIMIT_SIGNAL",
      "OUTPUT_LIMIT_SIGNAL",
      "CRASH_SIGNAL",
      "NONZERO_EXIT",
      "MEM_PEAK_OVER",
      "CPU_TIME_OVER",
      "OUTPUT_SIZE_OVER",
      "COMPARE"
    ],
    "compile_success_status": "COMPILED",
    "compile_success_verdict": null,
    "compile_success_reason": "NONE",
    "unknown_metric": null,
    "signal_exit_code": null,
    "aggregation": "all_ac_else_first_non_ac_by_sequence",
    "active_attempt_only": true,
    "short_circuit": {
      "default_evaluation_mode": "ordered_short_circuit",
      "window": 4,
      "cancel_reason": "SHORT_CIRCUITED"
    }
  },
  "scheduling": {
    "unit": "test_case",
    "strategies": [
      "fcfs",
      "sjf",
      "aging_sjf",
      "earliest_finish",
      "cache_aware"
    ],
    "default_strategy": "cache_aware",
    "ready_queue_order": [
      "enqueue_seq",
      "sequence",
      "attempt"
    ],
    "aging_factor": 1.25,
    "estimated_service_default_ms": 1500,
    "per_case_estimate_ms": 250
  },
  "hashing": {
    "content_algorithm": "sha256",
    "wire_prefix": "sha256:",
    "wire_hex_length": 64,
    "build_key_encoding": "canonical_json_utf8"
  }
}
