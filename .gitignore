/build/
/work/
*.o
*.obj
*.exe
*.dll

# Test/package archives are generated artifacts, never committed
*.zip
*.tar
*.tar.gz
*.tgz

# Editor/OS noise
.DS_Store
Thumbs.db
Desktop.ini
~$*
.idea/
.vscode/
.codex/
.claude/

# Evidence directories are committed only under artifacts/verification
# and artifacts/experiments; scratch output belongs under /work or /tmp.
/artifacts/tmp/
