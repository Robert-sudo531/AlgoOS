# Image overrides (use a reachable registry mirror when Docker Hub is blocked).
# MinIO: upstream minio/minio pulls are denied in this environment and the
# dl.min.io community binary returns 410; this is Chainguard's AGPLv3 MinIO
# build, pinned by digest. Set ALGOOS_S3_MODE=moto only as a local fallback.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
NATS_IMAGE=nats:2.11-alpine
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:9158c67aa441627c366442e84656f689e16bec4809851ec64318561a365b69e4

POSTGRES_USER=algoos
POSTGRES_PASSWORD=algoos
POSTGRES_DB=algoos
MINIO_ROOT_USER=algoos
MINIO_ROOT_PASSWORD=algoos-secret
