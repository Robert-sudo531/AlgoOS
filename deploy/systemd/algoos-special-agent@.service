[Unit]
Description=AlgoOS special queue agent for %i
After=algoos-special-worker@%i.service
Requires=algoos-special-worker@%i.service

[Service]
# Native worker creates a 0600 Unix socket; keep the agent UID aligned.
Type=simple
User=root
Group=root
WorkingDirectory=/opt/algoos
EnvironmentFile=-/etc/algoos/algoos.env
ExecStart=/opt/algoos/.venv/bin/algoos special-agent --config /etc/algoos/nodes/%i.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
