[Unit]
Description=AlgoOS special queue agent
After=algoos-special-worker.service
Requires=algoos-special-worker.service

[Service]
# Native worker creates a 0600 Unix socket; keep the agent UID aligned.
Type=simple
User=root
Group=root
WorkingDirectory=/opt/algoos
EnvironmentFile=-/etc/algoos/algoos.env
ExecStart=/opt/algoos/.venv/bin/algoos special-agent --config /etc/algoos/nodes/special-01.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
