[Unit]
Description=AlgoOS native compile worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=algoos
Group=algoos
RuntimeDirectory=algoos
WorkingDirectory=/opt/algoos
EnvironmentFile=-/etc/algoos/algoos.env
ExecStart=/opt/algoos/build/cpp/algoos-compile --socket /run/algoos/compile.sock --work-root /var/lib/algoos/compile --workers 2
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
