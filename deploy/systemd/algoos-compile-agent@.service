[Unit]
Description=AlgoOS compile queue agent for %i
After=algoos-compile-worker@%i.service
Requires=algoos-compile-worker@%i.service

[Service]
Type=simple
User=algoos
Group=algoos
WorkingDirectory=/opt/algoos
EnvironmentFile=-/etc/algoos/algoos.env
ExecStart=/opt/algoos/.venv/bin/algoos compile-agent --config /etc/algoos/nodes/%i.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
