# Copy to /etc/algoos/algoos.env and restrict to root:algoos 0640.
ALGOOS_DB_DSN=postgresql://algoos:CHANGE_ME@127.0.0.1:5432/algoos
ALGOOS_NATS_URL=nats://127.0.0.1:4222
ALGOOS_NATS_TOKEN=
ALGOOS_S3_ENDPOINT=http://127.0.0.1:9000
ALGOOS_S3_ACCESS_KEY=CHANGE_ME
ALGOOS_S3_SECRET_KEY=CHANGE_ME
ALGOOS_S3_BUCKET=algoos
ALGOOS_REDIS_URL=redis://127.0.0.1:6379/0
ALGOOS_API_TOKEN=CHANGE_ME_LONG_RANDOM
ALGOOS_API_HOST=0.0.0.0
ALGOOS_API_PORT=8080
ALGOOS_SCHEDULING_STRATEGY=cache_aware
ALGOOS_CONTROL_NODE_ID=control-01
ALGOOS_STALE_SECONDS=15
ALGOOS_REAPER_INTERVAL=2
ALGOOS_EVAL_ACK_WAIT=60
ALGOOS_CONTROL_ACK_WAIT=60
